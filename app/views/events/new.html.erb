<h1>Create a new event</h1>
<%= form_with model: @event do |form| %>
    <div>
        <%= form.label :title %>
        <%= form.text_field :title %>
    </div>
    <div>
        <%= form.label :location %>
        <%= form.text_field :location %>
    </div>
    <div>
        <%= form.label :planned_date %>
        <%= form.date_select :planned_date %>
    </div>
    <%= form.submit %>
<% end %>