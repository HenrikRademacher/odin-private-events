<h1>Event details</h1>
<p><%= link_to "Return to event overview", root_path %></p>

<%= @event.title %> at <%= @event.location %>
<br>
<%= @event.planned_date %>
<br>
hosted by <%= link_to @event.creator.username, "/users/#{@event.creator.id}" %>
<br>
<% if current_user && current_user.attended_events.include?(@event) %>
    <%= button_to "Rescind attendance", destroy_invitation_path, method: :delete %>
<% else %>
    <%= button_to "Join this event", new_invitation_path, method: :post %>
<% end %>