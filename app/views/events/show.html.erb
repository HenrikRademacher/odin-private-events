<h1>Event details</h1>
<p><%= link_to "Return to event overview", root_path %></p>

<%= @event.title %> at <%= @event.location %>
<br>
<%= @event.planned_date %>
<br>
hosted by <%= link_to @event.creator.username, "/users/#{@event.creator.id}" %>
<br>

<br><br>
<% if current_user == @event.creator %>
    <p>Invite a friend!</p>
    <% @invitation = Invitation.new %>
    <%= form_with model: @invitation do |form| %>
        
    <% end %>

<% end %>
<h2>Attendees:</h2>
<ul>
    <% @attendees.each do | attendee | %>
        <li><%= attendee.username %></li>
    <% end %>
</ul>