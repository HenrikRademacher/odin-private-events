<h1>Event details</h1>
<p><%= link_to "Return to event overview", root_path %></p>
<% if current_user == @event.creator %>
    <p><%= button_to "Edit this event", edit_event_path(@event), method: :get %> </p>
    <p><%= button_to "Delete this event", @event, method: :delete, data: { turbo_confirm: "Really delete this event?" } %> </p>
<% end %>

<%= @event.title %> at <%= @event.location %>
<br>
<%= @event.planned_date %>
<br>
hosted by <%= link_to @event.creator.username, "/users/#{@event.creator.id}" %>
<br>

<% if @event.public? || current_user == @event.creator %>
    <% if current_user.attended_events.include?(@event) %>
        <p>Remove yourself from this event</p>
        <% @invitation = Invitation.where(attended_event_id: @event.id).where(attendee_id: current_user.id).first %>
        <%= button_to "Remove", @invitation, method: :delete %>
    <% else %>
        <p>You may join this event without explicit invitation:</p>
        <% @invitation = Invitation.new %>
        <%= form_with model: @invitation do |form| %>
            <%= form.hidden_field :attended_event_id, value: @event.id %>
            <%= form.hidden_field :attendee_id, value: current_user.id %>
            <%= form.hidden_field :accepted, value: true %>
            <%= form.submit "Join this event" %>
        <% end %>
    <% end %>
<% end %>

<% if current_user == @event.creator %>
    <br><br>
    <p>Invite a friend!</p>
    <% @invitation = Invitation.new %>
    <%= form_with model: @invitation do |form| %>
        <%= form.hidden_field :attended_event_id, value: @event.id %>
        <%= form.label :attendee_id %>
        <%= form.collection_select :attendee_id, User.order(:username), :id, :username %>
        <%= form.submit %>
    <% end %>

<% end %>
<h2>Attendees:</h2>
<ul>
    <% @attendees.each do | attendee | %>
        <li><%= attendee.attendee.username %></li>
    <% end %>
</ul>
<h2>Awaiting response:</h2>
<ul>
    <% @invited.each do | invitee | %>
        <li><%= invitee.attendee.username %> </li>
    <% end %>
</ul>