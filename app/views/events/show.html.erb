<h1>Event details</h1>
<p><%= link_to "Return to event overview", root_path %></p>

<%= @event.title %> at <%= @event.location %>
<br>
<%= @event.planned_date %>
<br>
hosted by <%= link_to @event.creator.username, "/users/#{@event.creator.id}" %>
<br>

<br><br>
<% if current_user == @event.creator %>
    <p>Invite a friend!</p>
    <% @invitation = Invitation.new %>
    <%= form_with model: @invitation do |form| %>
        <%= form.hidden_field :attended_event_id, value: @event.id %>
        <%= form.label :attendee_id %>
        <%= form.collection_select :attendee_id, User.order(:username), :id, :username %>
        <%= form.submit %>
    <% end %>

<% end %>
<h2>Attendees:</h2>
<ul>
    <% @attendees.each do | attendee | %>
        <li><%= attendee.attendee.username %></li>
    <% end %>
</ul>
<h2>Awaiting response:</h2>
<ul>
    <% @invited.each do | invitee | %>
        <li><%= invitee.attendee.username %> </li>
    <% end %>
</ul>