<% if user_signed_in? %>
  <h1>Welcome, <%= current_user.username %></h1>
  <%= link_to "Sign out", destroy_user_session_path, data: { turbo_method: :delete } %>
  <br>
  <%= link_to "Look at your page", "/users/#{current_user.id}" %>
<% else %>
  <h1>Welcome, guest!</h1>
  <%= link_to "Sign In", new_user_session_path %>
<% end %>
<h1>View upcoming events:</h1>
<%= link_to "Create your event", new_event_path %>
<ul>
  <% @future_events.each do | event | %>
    <li>
      <%= link_to event.title, event_path(event.id) %> at <%= event.location %>
      <br>
      hosted by <%= link_to event.creator.username, "/users/#{event.creator.id}" %>
    </li>
  <% end %>
</ul>
<h1>View past events:</h1>
<ul>
  <% @past_events.each do | event | %>
    <li>
      <%= link_to event.title, event_path(event.id) %> at <%= event.location %>
      <br>
      hosted by <%= link_to event.creator.username, "/users/#{event.creator.id}" %>
    </li>
  <% end %>
</ul>